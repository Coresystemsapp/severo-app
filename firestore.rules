rules_version = '2';
// Severo · regras do Firestore
// Perfis da central (coleção usuarios, campo papel):
//   admin       tudo, inclusive usuários e acessos
//   gestao      fila, cargas e negociações de toda a equipe
//   operador    fila e cargas
//   financeiro  fila, cargas e exportação
//   operacoes   somente leitura das cargas
// Motorista: lê e altera só o que é dele. Usuário com ativo == false perde o acesso na hora.
service cloud.firestore {
  match /databases/{db}/documents {
    function logado() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    function perfil() { return get(/databases/$(db)/documents/usuarios/$(eu())).data; }
    function equipe() {
      return logado()
        && exists(/databases/$(db)/documents/usuarios/$(eu()))
        && perfil().get('ativo', true) == true;
    }
    function central() { return equipe() && perfil().papel in ['admin', 'gestao', 'operador', 'financeiro']; }
    function admin() { return equipe() && perfil().papel == 'admin'; }

    match /usuarios/{uid} {
      allow read: if logado() && (eu() == uid || central());
      // a própria pessoa só atualiza presença (visto, dispositivo, último acesso)
      allow update: if admin()
        || (logado() && eu() == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id', 'vistoEm', 'ultimoAcesso', 'dispositivo', 'email']));
      allow create, delete: if admin();
    }

    match /acessos/{id} {
      allow read: if admin();
      allow create: if equipe() && request.resource.data.uid == eu();
    }

    match /motoristas/{uid} {
      allow read: if logado() && (eu() == uid || central());
      allow create: if logado() && eu() == uid && request.resource.data.cadastro == 'pendente';
      allow update: if central()
        || (logado() && eu() == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cadastro']));
    }

    match /veiculos/{id} {
      allow read: if logado() && (resource.data.motoristaId == eu() || central());
      allow create: if logado() && request.resource.data.motoristaId == eu();
      allow update: if central()
        || (logado() && resource.data.motoristaId == eu() && request.resource.data.motoristaId == eu());
    }

    match /disponibilidades/{id} {
      allow read: if logado() && (resource.data.motoristaId == eu() || central());
      allow create: if logado()
        && request.resource.data.motoristaId == eu()
        && request.resource.data.status == 'disponivel'
        && request.resource.data.responsavelId == null;
      // motorista: atualiza o aviso, cancela, e responde à proposta (aceitar, negociar ou recusar)
      allow update: if central()
        || (logado() && resource.data.motoristaId == eu()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'motoristaNome', 'telefone', 'veiculoId', 'veiculo', 'cidade', 'uf', 'bairro', 'lat', 'lng', 'localEm', 'quando',
                 'ocupacao', 'capacidadeLivreKg', 'destinos', 'aceitaOutras', 'obs', 'audioUrl', 'expiraEm',
                 'atualizadoEm', 'historico', 'status', 'proposta', 'respostaMotorista', 'contraproposta'])
            && (request.resource.data.status == resource.data.status
                || request.resource.data.status == 'cancelado'
                || (resource.data.status == 'proposta_enviada'
                    && request.resource.data.status in ['aguardando_aprovacao', 'em_atendimento', 'contraproposta']))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['proposta'])
                || request.resource.data.proposta == null));
      allow delete: if admin();
    }

    // áudios salvos sem Storage (plano gratuito)
    match /audios/{dispId} {
      allow read: if logado() && (resource.data.motoristaId == eu() || central());
      allow create, update: if logado() && request.resource.data.motoristaId == eu();
    }

    // cargas: operações só lê
    match /cargas/{id} {
      allow read: if equipe();
      allow write: if central();
    }

    // vitrine: versão da carga para o app do motorista
    match /cargasPublicas/{id} {
      allow read: if logado();
      allow write: if central();
    }

    // "tenho interesse" / "quero negociar" do motorista em uma carga
    match /interesses/{id} {
      allow read: if logado() && (resource.data.motoristaId == eu() || central());
      allow create, update: if central() || (logado() && request.resource.data.motoristaId == eu());
    }

    match /atendimentos/{id} { allow read, write: if central(); }
  }
}
